<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Allow floating versions (e.g. "4.0.*") so the DIR.Lib pin auto-picks
         up new CI publishes without manual bumps here. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.0.0" />
    <PackageVersion Include="DIR.Lib" Version="7.19.*" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.300" />
    <!-- No SharpAstro.LALR.CC entry on purpose. The grammars and the LALR.CC
         source generator moved to DIR.Lib.Markdown in v2.14, so no project in
         this repo declares a PackageReference to it any more — it arrives
         transitively through DIR.Lib, which owns the pin. A PackageVersion here
         with nothing referencing it is inert: it cannot constrain the transitive
         resolve (transitive pinning is off), it just reads like a pin and drifts.
         This one sat at 3.1.* through the whole 4.x line saying nothing.
         If a project here ever takes a direct dependency, restore fails loudly
         with NU1010 — add the pin back then, tracking DIR.Lib's. -->
    <!-- Image-codec facade for markdown inline-image decode (ImageCodecs); pulls PNG/JPEG in lockstep. -->
    <PackageVersion Include="SharpAstro.Codecs" Version="3.8.*" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- Markdig and YamlDotNet were dropped when the Markdown / LaTeX parser
         layer relocated to DIR.Lib.Markdown in v2.14: Markdig was replaced by
         the LALR.CC inline + block grammars, and YamlDotNet was only a build-
         time dep of the LALR.CC source generator that ships with those grammars. -->
  </ItemGroup>

</Project>
