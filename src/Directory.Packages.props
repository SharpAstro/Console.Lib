<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Allow floating versions (e.g. "4.0.*") so the DIR.Lib pin auto-picks
         up new CI publishes without manual bumps here. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.0.0" />
    <PackageVersion Include="DIR.Lib" Version="7.2.*" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.5.1" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.300" />
    <PackageVersion Include="SharpAstro.LALR.CC" Version="3.1.*" />
    <!-- Image-codec facade for markdown inline-image decode (ImageCodecs); pulls PNG/JPEG in lockstep. -->
    <PackageVersion Include="SharpAstro.Codecs" Version="3.6.*" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- Markdig and YamlDotNet were dropped when the Markdown / LaTeX parser
         layer relocated to DIR.Lib.Markdown in v2.14: Markdig was replaced by
         the LALR.CC inline + block grammars, and YamlDotNet was only a build-
         time dep of the LALR.CC source generator that ships with those grammars. -->
  </ItemGroup>

</Project>
