<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- No version properties here: VersionPrefix and AssemblyVersion are both derived from
         VersionMajorMinor in ../Directory.Build.props. Edit the version there. -->
    <PackageID>Console.Lib</PackageID>
    <Description>Terminal application toolkit for .NET: dock-based layouts that recompute on resize, a widget set (text bars, scrollable lists, tree views, text areas, menus, Markdown), mouse and keyboard input, VT styling, and a fast Sixel graphics encoder with sextant / half-block fallbacks. Built on DIR.Lib, AOT compatible.</Description>
    <PackageTags>console terminal tui sixel vt ansi widgets layout aot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/SharpAstro/Console.Lib.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!--
    Opt-in Debug twin (-p:DebugTwin=true): the same library packed from a Debug build as Console.Lib.Debug,
    at the same version as Console.Lib. A published Console.Lib is built Release, so every #if DEBUG type in
    it (ConsoleDebugInspector and the rest of the debug-inspector layer) is absent and a Debug consumer
    cannot compile against it. A consumer switches with a Configuration-conditioned PackageReference:
    Console.Lib when not Debug, Console.Lib.Debug when Debug. Visual Studio needs a restore after switching
    configuration.
  -->
  <PropertyGroup Condition="'$(DebugTwin)' == 'true'">
    <PackageID>Console.Lib.Debug</PackageID>
    <Description>The Debug build of Console.Lib, for Debug consumers that need ConsoleDebugInspector and the other #if DEBUG types, which the Release Console.Lib package does not contain. Same version as Console.Lib, and it depends on DIR.Lib.Debug rather than DIR.Lib. Reference Console.Lib when the configuration is not Debug and Console.Lib.Debug when it is, with a Configuration-conditioned PackageReference; Visual Studio needs a restore after switching configuration.</Description>
  </PropertyGroup>
  <Target Name="RequireDebugForTwin" BeforeTargets="Pack;GenerateNuspec;CoreCompile" Condition="'$(DebugTwin)' == 'true' AND '$(Configuration)' != 'Debug'">
    <Error Text="DebugTwin=true packs Console.Lib.Debug and must be built with -c Debug (Configuration is '$(Configuration)')." />
  </Target>

  <ItemGroup>
    <InternalsVisibleTo Include="Console.Lib.Tests" />
  </ItemGroup>

  <!-- Alias the DIR.Lib.Layout namespace so files write the qualified `Layout.Node` / `Layout.Builder`
       form without importing the namespace's collision-prone barewords (Node, Content, Size<T>). -->
  <ItemGroup>
    <Using Include="DIR.Lib.Layout" Alias="Layout" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    DIR.Lib (rendering primitives + font rasterization) is referenced via
    ProjectReference when a sibling working copy exists, so iteration can
    happen in-tree. CI / package builds without the sibling fall through
    to PackageReference automatically.
  -->
  <PropertyGroup>
    <UseLocalDirLib Condition="'$(DebugTwin)' == 'true'">false</UseLocalDirLib>
    <UseLocalDirLib Condition="'$(UseLocalDirLib)' == '' AND Exists('..\..\..\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj')">true</UseLocalDirLib>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalDirLib)' == 'true'">
    <ProjectReference Include="..\..\..\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalDirLib)' != 'true' AND '$(DebugTwin)' != 'true'">
    <PackageReference Include="DIR.Lib" />
  </ItemGroup>
  <!-- The twin depends on DIR.Lib.Debug, never DIR.Lib, and never on the sibling project (which would put
       DIR.Lib in the nuspec), so DebugTwin forces the package path above. -->
  <ItemGroup Condition="'$(DebugTwin)' == 'true'">
    <PackageReference Include="DIR.Lib.Debug" />
  </ItemGroup>

  <!--
    Markdown image decoding (MarkdownRendererLalr.TryRenderImage) sniffs the
    format by magic bytes and decodes via the SharpAstro.Codecs facade
    (ImageCodecs), which pulls the individual codecs (PNG/JPEG) in lockstep.
    Referenced DIRECTLY (not relied on transitively via DIR.Lib -> Fonts) so the
    compile can't break when an unrelated dependency stops pulling it in.
    IsAotCompatible, composing with this library's AOT contract. Inline markdown
    images are PNG/JPEG; other formats fall back to alt-text.

    Referenced via ProjectReference when the Codecs sibling working copy
    exists (so codec changes can be iterated in-tree); CI / package builds fall
    through to PackageReference automatically. The switch probes SharpAstro.Png
    (present iff the Codecs repo is checked out).
  -->
  <PropertyGroup>
    <UseLocalSharpAstroCodecs Condition="'$(UseLocalSharpAstroCodecs)' == '' AND Exists('..\..\..\Codecs\src\SharpAstro.Png\SharpAstro.Png.csproj')">true</UseLocalSharpAstroCodecs>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalSharpAstroCodecs)' == 'true'">
    <ProjectReference Include="..\..\..\Codecs\src\SharpAstro.Codecs\SharpAstro.Codecs.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSharpAstroCodecs)' != 'true'">
    <PackageReference Include="SharpAstro.Codecs" />
  </ItemGroup>


  <!--
    The LALR.CC source generator + YamlDotNet build dependency + the
    grammars/*.lalr.yaml moved to DIR.Lib.Markdown in v2.14. Console.Lib
    consumes the generated parser classes (Latex, MarkdownInline,
    MarkdownBlock — emitted into the DIR.Lib namespace) via the DIR.Lib
    PackageReference / ProjectReference above; no grammar files or
    source-generator wiring live here anymore.
  -->

</Project>
