<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <VersionPrefix>3.4.0</VersionPrefix>
    <AssemblyVersion>3.4.0.0</AssemblyVersion>
    <PackageID>Console.Lib</PackageID>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/SharpAstro/Console.Lib.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Console.Lib.Tests" />
  </ItemGroup>

  <!-- Alias the DIR.Lib.Layout namespace so files write the qualified `Layout.Node` / `Layout.Builder`
       form without importing the namespace's collision-prone barewords (Node, Content, Size<T>). -->
  <ItemGroup>
    <Using Include="DIR.Lib.Layout" Alias="Layout" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    DIR.Lib (rendering primitives + font rasterization) is referenced via
    ProjectReference when a sibling working copy exists, so iteration can
    happen in-tree. CI / package builds without the sibling fall through
    to PackageReference automatically.
  -->
  <PropertyGroup>
    <UseLocalDirLib Condition="'$(UseLocalDirLib)' == '' AND Exists('..\..\..\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj')">true</UseLocalDirLib>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalDirLib)' == 'true'">
    <ProjectReference Include="..\..\..\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalDirLib)' != 'true'">
    <PackageReference Include="DIR.Lib" />
  </ItemGroup>

  <!--
    Markdown image decoding (StbImageSharp.ImageResult.FromMemory in
    MarkdownRendererLalr) uses StbImageSharp, which is already in the closure
    transitively via DIR.Lib -> SharpAstro.Fonts (used there for CBDT/sbix
    bitmap-glyph PNGs). It is IsAotCompatible, so it composes with this
    library's AOT contract. No explicit reference is added here to avoid a
    project-vs-package clash in the local DIR.Lib dev setup above; the
    transitive compile + runtime reference covers both modes.
  -->


  <!--
    The LALR.CC source generator + YamlDotNet build dependency + the
    grammars/*.lalr.yaml moved to DIR.Lib.Markdown in v2.14. Console.Lib
    consumes the generated parser classes (Latex, MarkdownInline,
    MarkdownBlock — emitted into the DIR.Lib namespace) via the DIR.Lib
    PackageReference / ProjectReference above; no grammar files or
    source-generator wiring live here anymore.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
