<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <VersionPrefix>2.12.0</VersionPrefix>
    <AssemblyVersion>2.12.0.0</AssemblyVersion>
    <PackageID>Console.Lib</PackageID>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/SharpAstro/Console.Lib.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Console.Lib.Tests" />
    <!-- The LatexConsole example (in this repo's examples/ tree) uses the
         internal BoxBuildingVisitor to demonstrate pixel-rendered math in
         isolation, separate from the markdown pipeline. -->
    <InternalsVisibleTo Include="Examples.LatexConsole" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!--
    DIR.Lib (rendering primitives + font rasterization) is referenced via
    ProjectReference when a sibling working copy exists, so iteration can
    happen in-tree. CI / package builds without the sibling fall through
    to PackageReference automatically.
  -->
  <PropertyGroup>
    <UseLocalDirLib Condition="'$(UseLocalDirLib)' == '' AND Exists('..\..\..\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj')">true</UseLocalDirLib>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalDirLib)' == 'true'">
    <ProjectReference Include="..\..\..\DIR.Lib\src\DIR.Lib\DIR.Lib.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalDirLib)' != 'true'">
    <PackageReference Include="DIR.Lib" />
  </ItemGroup>

  <!--
    SharpAstro.LALR.CC drives the math-mode LaTeX parser baked into the
    MarkdownRenderer. The Roslyn source generator runs at build time on
    grammars/latex.lalr.yaml and emits a Latex partial class into this
    assembly — no runtime parser construction, AOT-clean. Same sibling-
    or-NuGet conditional pattern as DIR.Lib above.
  -->
  <PropertyGroup>
    <UseLocalLalrCc Condition="'$(UseLocalLalrCc)' == '' AND Exists('..\..\..\LALR.CC\LALR.CC\LALR.CC.csproj')">true</UseLocalLalrCc>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalLalrCc)' == 'true'">
    <ProjectReference Include="..\..\..\LALR.CC\LALR.CC\LALR.CC.csproj" />
    <ProjectReference Include="..\..\..\LALR.CC\LALR.CC.SourceGenerators\LALR.CC.SourceGenerators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalLalrCc)' != 'true'">
    <PackageReference Include="SharpAstro.LALR.CC" />
  </ItemGroup>

  <!--
    YamlDotNet is consumed only by the LALR.CC source generator (build-time)
    to parse latex.lalr.yaml. PrivateAssets="all" keeps it out of the runtime
    closure and out of the published package; the Analyzer item passes its
    netstandard2.0 DLL into the analyzer load context next to the source
    generator. The generated Latex partial class has no YamlDotNet references.
  -->
  <ItemGroup>
    <PackageReference Include="YamlDotNet" GeneratePathProperty="true" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Analyzer Include="$(PkgYamlDotNet)\lib\netstandard2.0\YamlDotNet.dll" />
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="grammars\latex.lalr.yaml" Link="latex.lalr.yaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.SourceLink.GitHub">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
