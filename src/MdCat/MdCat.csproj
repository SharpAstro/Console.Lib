<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mdcat</ToolCommandName>
    <AssemblyName>mdcat</AssemblyName>

    <!-- mdcat's version is melded to Console.Lib's: CI passes -p:Version to the
         whole solution, so the published tool tracks the library version. Keep
         this X.Y in sync with Console.Lib's VersionPrefix (see ../../CLAUDE.md). -->
    <VersionPrefix>2.18.0</VersionPrefix>

    <!-- Published to nuget.org as a global tool (`dotnet tool install -g
         mdcat`) by the CI pipeline. We do NOT set GeneratePackageOnBuild:
         tool packaging needs the publish-gather that only `dotnet pack`
         performs (a plain build emits a tools/ folder with no payload), so
         dotnet.yml runs an explicit `dotnet pack src/MdCat` step. The same
         -p:Version CI passes to the solution melds this with Console.Lib. -->
    <PackageId>mdcat</PackageId>
    <Description>A 'cat' for Markdown — render Markdown files (and stdin) to styled terminal output: headings, lists, code blocks, OSC 8 hyperlinks, and LaTeX math (sixel/sextant/half-block).</Description>
    <PackageTags>markdown;cli;terminal;cat;renderer;tool;console;latex;math</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <RepositoryUrl>https://github.com/SharpAstro/Console.Lib.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <!-- Floor the framework-dependent tool at the 10.0 GA runtime so it runs on
         ANY installed 10.0.x via roll-forward. Without this, the SDK pins the
         runtimeconfig to whatever patch CI built with (e.g. 10.0.9), and roll-
         forward never goes *down* — so users on an earlier 10.0 patch get
         "You must install or update .NET". Gated on an empty RuntimeIdentifier
         so the self-contained AOT publish (mdcat-release.yml, -r <rid>) keeps
         bundling the latest runtime instead of 10.0.0. -->
    <RuntimeFrameworkVersion Condition="'$(RuntimeIdentifier)' == ''">10.0.0</RuntimeFrameworkVersion>

    <!-- Released as native, self-contained per-platform binaries via
         .github/workflows/mdcat-release.yml (dotnet publish -r <rid>). AOT
         here also turns on the trim/AOT analyzers for the normal solution
         build, so AOT regressions surface on PRs rather than at release time.
         The whole dependency closure (Console.Lib + DIR.Lib + StbImageSharp)
         is IsAotCompatible. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Console.Lib\Console.Lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle the STIX Two Math font (OFL) next to the exe so display-math
         rasterizes consistently without relying on system fonts. Program.cs's
         ResolveMathFont() looks for Fonts/STIX2Math.otf under the app base dir.
         Source of truth is DIR.Lib.Tests/Fonts; this is a copy so the tool
         stays self-contained when packed as a global tool. -->
    <Content Include="Fonts\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
