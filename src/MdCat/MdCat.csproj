<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>mdcat</ToolCommandName>
    <AssemblyName>mdcat</AssemblyName>
    <VersionPrefix>1.0.0</VersionPrefix>
    <!-- Released as native, self-contained per-platform binaries via
         .github/workflows/mdcat-release.yml (dotnet publish -r <rid>). AOT
         here also turns on the trim/AOT analyzers for the normal solution
         build, so AOT regressions surface on PRs rather than at release time.
         The whole dependency closure (Console.Lib + DIR.Lib + StbImageSharp)
         is IsAotCompatible. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Console.Lib\Console.Lib.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundle the STIX Two Math font (OFL) next to the exe so display-math
         rasterizes consistently without relying on system fonts. Program.cs's
         ResolveMathFont() looks for Fonts/STIX2Math.otf under the app base dir.
         Source of truth is DIR.Lib.Tests/Fonts; this is a copy so the tool
         stays self-contained when packed as a global tool. -->
    <Content Include="Fonts\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
