<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Manual tool (not in Console.Lib.sln, so CI never publishes or AOT-compiles it): proves the inspector is trimmed
    out of a NativeAOT terminal app by DIR.Lib's feature switch (DebugInspectorCore.IsSupported, DIR.Lib 11.73),
    and measures what keeping it costs. Sits outside src/ so Central Package Management does not apply to it.

    Run (Git Bash needs the VS Installer folder on PATH first, or the link step fails MSB3073 on vswhere):
      dotnet publish tools/inspector-aot-probe/InspectorAotProbe.csproj -c Release -r win-x64 -p:IlcGenerateMapFile=true -o OUT1
      dotnet publish tools/inspector-aot-probe/InspectorAotProbe.csproj -c Release -r win-x64 -p:IlcGenerateMapFile=true -p:DirInspectorSupport=true -o OUT2
    OUT1 (the default) drops ConsoleDebugInspector; OUT2 keeps it. Compare the .exe sizes and search the .map files, then
    run each with DIR_INSPECTOR=1 DIR_INSPECTOR_TOKEN=probe: OUT1 prints one "trimmed out of this build" line on
    stderr and starts nothing, OUT2 starts the command server.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Console.Lib\Console.Lib.csproj" />
  </ItemGroup>

</Project>
