<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Proves a Debug build sees the #if DEBUG types of Console.Lib and DIR.Lib: it compiles only against the
    Console.Lib.Debug twin package (packed from a Debug build into artifacts/debug-twin), never against the
    Release Console.Lib, where ConsoleDebugInspector does not exist. Sits outside src/ so Central Package
    Management does not apply, and has no ProjectReference on purpose: the package is the thing under test.
    CI overrides the version with -p:ConsoleLibDebugVersion=<run-stamped version>.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Its own package folder, so a re-pack of the same version is never served from the global cache. -->
    <RestorePackagesPath>$(MSBuildProjectDirectory)/obj/packages</RestorePackagesPath>
    <ConsoleLibDebugVersion Condition="'$(ConsoleLibDebugVersion)' == ''">$([System.Text.RegularExpressions.Regex]::Match($([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../src/Directory.Build.props')), '&lt;VersionMajorMinor&gt;([^&lt;]+)&lt;').Groups[1].Value).0</ConsoleLibDebugVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Console.Lib.Debug" Version="$(ConsoleLibDebugVersion)" />
  </ItemGroup>

  <!--
    A mixed twin must not pass: if the restore pulled the plain DIR.Lib package (the twin depending on
    DIR.Lib instead of DIR.Lib.Debug), the dependency is wrong even when the code happens to compile.
    Read the restore result and fail on it.
  -->
  <Target Name="RequireDebugDirLib" BeforeTargets="CoreCompile" Condition="Exists('$(ProjectAssetsFile)')">
    <PropertyGroup>
      <_Assets>$([System.IO.File]::ReadAllText('$(ProjectAssetsFile)'))</_Assets>
    </PropertyGroup>
    <Error Condition="$(_Assets.Contains('&quot;DIR.Lib/'))" Text="The restore pulled the plain DIR.Lib package; Console.Lib.Debug must depend on DIR.Lib.Debug only." />
    <Error Condition="!$(_Assets.Contains('&quot;DIR.Lib.Debug/'))" Text="The restore did not pull DIR.Lib.Debug." />
  </Target>

</Project>
